# NetRunner beta environment.
#
#   cp .env.beta.example .env      # then change every value marked `change_me_`
#
# Compose reads this file twice: for ${VAR} substitution inside the compose
# files, and (via `env_file:`) as the runtime environment of the ops-web and
# ops-worker containers. Anything you add here reaches the app — the only
# exceptions are values the compose files set explicitly, which win.
#
# See docs/BETA_DEPLOYMENT.md for the full bring-up and verification procedure.

# --- Required: change these -------------------------------------------------
# Postgres password. docker-compose.yml builds DATABASE_URL from this value, so
# the app's DATABASE_URL is derived rather than duplicated here.
POSTGRES_PASSWORD=change_me_postgres_password

# Session signing secret. REQUIRED in production: without it the server
# generates a random secret on every start and every login is invalidated by a
# restart (the app now refuses to boot in production rather than do that).
JWT_SECRET=change_me_long_random_secret

# Soulseek account used by slskd. A real account is required for acquisition;
# the stack still starts without one, but searches and downloads will fail.
SLSKD_USERNAME=change_me_soulseek_username
SLSKD_PASSWORD=change_me_soulseek_password
# Shared by the app (X-API-Key) and slskd (its primary key), so the stack
# wires both sides from this one value. Must be 16-255 characters or
# slskd exits at startup. Generate one: openssl rand -base64 48
SLSKD_API_KEY=change_me_random_api_key

# --- Streaming (Subsonic API served by NetRunner) ---------------------------
# This is what music clients (Symfonium, DSub, Amperfy, Feishin, ...) connect to
# at http://<host>:<BETA_HTTP_PORT>/rest. Enabling it without a password leaves
# the token-auth path forgeable, so production requires SUBSONIC_PASSWORD.
SUBSONIC_ENABLED=true

# The beta stack publishes its HTTP port on 127.0.0.1 only: it serves plain HTTP
# with session cookies and Subsonic credentials. Put a TLS terminator in front,
# or set BETA_BIND_ADDR=0.0.0.0 if something upstream already terminates TLS.
BETA_BIND_ADDR=127.0.0.1

# Only used by the optional `media-server` profile. Leaving these empty disables
# Navidrome's dev bootstrap admin (whose image default is admin/admin).
NAVIDROME_ADMIN_USER=
NAVIDROME_ADMIN_PASSWORD=
SUBSONIC_PASSWORD=change_me_streaming_secret

# --- Beta topology ----------------------------------------------------------
# production semantics: loads config.production.yaml (stricter auth rate limit)
# and turns on the fail-fast checks above.
ENVIRONMENT=production
CONFIG_ENV=production
DOMAIN=localhost
BETA_HTTP_PORT=8080

# --- Optional: external media server ----------------------------------------
# Leave NAVIDROME_URL empty to use only the Subsonic API NetRunner serves
# itself (the simplest beta). Set it when you run the bundled Navidrome with
# `--profile media-server` (then use http://navidrome:4533) or an existing
# server on your network — the worker then triggers rescans and dedup checks.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASS=
# Admin password for the bundled Navidrome (ND_DEVAUTOCREATEADMINPASSWORD).
NAVIDROME_ADMIN_PASSWORD=change_me_navidrome_admin
NAVIDROME_PORT=4533

# --- Optional: enrichment providers -----------------------------------------
# All optional; AcoustID unlocks fingerprint dedup, the rest enrich metadata.
MUSICBRAINZ_USER_AGENT=NetRunner/1.0.0 (you@example.com)
MUSICBRAINZ_API_KEY=
ACOUSTID_API_KEY=
LASTFM_API_KEY=
LISTENBRAINZ_TOKEN=
DISCOGS_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LIDARR_URL=
LIDARR_API_KEY=

# --- Optional: egress proxy for P2P and API traffic -------------------------
PROXY_URL=

# --- Optional: notifications ------------------------------------------------
NOTIFICATION_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
