# E2E test environment template.
#
# You normally do not need to copy this by hand: `scripts/e2e.sh` generates
# `.env.e2e` from this file when it is missing, so a fresh clone can run the
# browser suite with one command.
#
# This is NOT a deployment template. The stack built from it is a throwaway
# (docker-compose.e2e.yml publishes :8080 and the setup script drops and
# recreates a `musicops_test` database). The values are deliberately static so
# runs are reproducible; none of them protect anything real.

# --- Needed by ${VAR} substitution in docker-compose.yml / .e2e.yml ---
# The postgres service takes its role password from this, and the e2e overlay
# interpolates the same variable into ops-web's DATABASE_URL, so the two cannot
# drift. It only applies on first initialisation of the volume, which is why
# teardown uses `down -v`.
POSTGRES_PASSWORD=e2e_test_password

# slskd receives this as its primary API key. It must be 16-255 characters:
# below that slskd logs a length error and exits with code 0, which looks like
# a clean stop. ops-worker waits on `slskd: service_healthy`, so a bad key here
# wedges the whole e2e stack rather than failing loudly.
SLSKD_API_KEY=e2e-test-api-key-0123456789abcdef
SLSKD_USERNAME=e2e-user
SLSKD_PASSWORD=e2e-pass

# --- Needed for the app to boot ---
ENVIRONMENT=development
CONFIG_ENV=development
JWT_SECRET=e2e_jwt_secret_not_used_for_anything_real

# --- Subsonic ---
# docker-compose.e2e.yml sets SUBSONIC_ENABLED=true (that wins over this file),
# and the token-auth path is refused outright when no password is configured,
# so subsonic.spec.ts cannot authenticate without SUBSONIC_PASSWORD.
SUBSONIC_ENABLED=true
SUBSONIC_PASSWORD=e2e_subsonic_password
