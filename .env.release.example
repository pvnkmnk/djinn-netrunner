# NetRunner release environment.
#
#   cp .env.release.example .env      # then change every value marked `change_me_`
#
# Compose reads this file twice: for ${VAR} substitution inside the compose
# files, and (via `env_file:`) as the runtime environment of the ops-web and
# ops-worker containers. Anything you add here reaches the app — the only
# exceptions are values the compose files set explicitly, which win.
#
# See docs/DEPLOYMENT.md for the full bring-up and verification procedure.

# --- Required: change these -------------------------------------------------
# Postgres password. docker-compose.yml builds DATABASE_URL from this value, so
# the app's DATABASE_URL is derived rather than duplicated here.
POSTGRES_PASSWORD=change_me_postgres_password

# Session signing secret. REQUIRED in production: without it the server
# generates a random secret on every start and every login is invalidated by a
# restart (the app now refuses to boot in production rather than do that).
JWT_SECRET=change_me_long_random_secret

# Soulseek account used by slskd. A real account is required for acquisition;
# the stack still starts without one, but searches and downloads will fail.
SLSKD_USERNAME=change_me_soulseek_username
SLSKD_PASSWORD=change_me_soulseek_password
# Shared by the app (X-API-Key) and slskd (its primary key), so the stack
# wires both sides from this one value. Must be 16-255 characters or
# slskd exits at startup. Generate one: openssl rand -base64 48
SLSKD_API_KEY=change_me_random_api_key

# --- Bootstrap admin --------------------------------------------------------
# Registration creates every account as a plain user, and nothing else in the
# stack promotes anyone: on a fresh install this is the only route to the admin
# surface (/admin - users, audit log, runtime config) short of editing the
# database by hand. Set it BEFORE you register, then restart:
#
#   BOOTSTRAP_ADMIN_EMAIL=you@example.com
#
# An address that already exists is promoted at startup; one that does not exist
# yet is promoted the moment it registers. The promotion happens once per
# address, so leaving this set is harmless and a later role change is never
# undone. Remove it once you are signed in as admin.
BOOTSTRAP_ADMIN_EMAIL=

# --- Streaming (Subsonic API served by NetRunner) ---------------------------
# Music clients should use an HTTPS endpoint (https://<tls-host>/rest) and
# prefer token/salt auth. Reusable legacy account passwords (`p=`) are accepted
# only over verified external HTTPS. The handler can reject `p=` over HTTP only
# after the credential crossed that HTTP hop; rejection is not transit
# protection. Without a shared password, token auth is forgeable, so production
# requires SUBSONIC_PASSWORD.
SUBSONIC_ENABLED=true

# The app's HTTP listener is published on 127.0.0.1 only. Keep it loopback-only
# behind a TLS terminator; the Caddy-to-app hop is still plain HTTP, so keep the
# Compose network controlled. For legacy p= auth through Caddy, the proxy must
# overwrite X-Forwarded-Proto. This checked-in Compose network does not pin a
# stable Caddy source IP: reserve/inspect that peer in your own deployment, then
# set SUBSONIC_TRUSTED_PROXY_CIDRS=<CADDY_PEER_CIDR> to only its exact CIDR.
# The placeholder is not a literal value; do not guess or broaden to RFC1918/ULA.
# Leave the allowlist empty for direct TLS or until the proxy peer is known.
# For an allowlisted proxy, require exactly one X-Forwarded-Proto: https even
# when the proxy-to-origin socket uses TLS; that hop does not prove external HTTPS.
APP_BIND_ADDR=127.0.0.1

# Only used by the optional `media-server` profile. Leaving these empty disables
# Navidrome's dev bootstrap admin (whose image default is admin/admin).
NAVIDROME_ADMIN_USER=
NAVIDROME_ADMIN_PASSWORD=
SUBSONIC_PASSWORD=change_me_streaming_secret
SUBSONIC_TRUSTED_PROXY_CIDRS=

# --- Release topology ----------------------------------------------------------
# ENVIRONMENT/CONFIG_ENV are pinned by docker-compose.release.yml, not read
# from here; the lines are kept so the two agree on what a release runs.
ENVIRONMENT=production
CONFIG_ENV=production
DOMAIN=localhost
APP_HTTP_PORT=8080
# Postgres publish on the host, for debugging only. Override when
# another postgres already holds 5432 (DJI-504); the stack itself talks
# over the compose network and ignores this.
#PG_HOST_PORT=15432

# The release this deployment runs. `scripts/deploy.sh` sets this
# automatically from the checked-out git tag and writes it back here; it is
# stamped into the image at build time AND used as the image tag, so a dev
# build and a release build never share one. Leave it empty to build an
# unreleased image, which reports "dev".
APP_VERSION=

# --- Optional: external media server ----------------------------------------
# Leave NAVIDROME_URL empty to use only the Subsonic API NetRunner serves
# itself (the simplest deployment). Set it when you run the bundled Navidrome with
# `--profile media-server` (then use http://navidrome:4533) or an existing
# server on your network — the worker then triggers rescans and dedup checks.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASS=
NAVIDROME_PORT=4533

# --- Optional: enrichment providers -----------------------------------------
# All optional. AcoustID unlocks fingerprint dedup, which also needs the
# fpcalc (Chromaprint) binary in the worker image — the image ships neither,
# so this key alone is inert. The rest enrich metadata.
MUSICBRAINZ_USER_AGENT=NetRunner/1.0.0 (you@example.com)
MUSICBRAINZ_API_KEY=
ACOUSTID_API_KEY=
LASTFM_API_KEY=
LISTENBRAINZ_TOKEN=
DISCOGS_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LIDARR_URL=
LIDARR_API_KEY=

# --- Optional: provider-client HTTP proxy -----------------------------------
# Used by proxy-aware provider clients only. RSS/Bandcamp feeds bypass PROXY_URL
# and use strict direct-fetch checks; Soulseek P2P is managed by slskd. yt-dlp
# uses the separate YTDLP_PROXY setting below.
PROXY_URL=

# --- yt-dlp validating egress boundary (DJI-501) -----------------------------
# The release overlay runs a squid sidecar that denies private/loopback ranges at
# connect time for every hop yt-dlp takes, and this line is what points yt-dlp
# at it. Empty the value to bypass the boundary (yt-dlp gets direct egress) --
# not recommended. Extraction sites beyond the defaults live in
# ops/squid/allowed-domains.txt.
YTDLP_PROXY=http://egress-proxy:3128

# --- Optional: notifications ------------------------------------------------
NOTIFICATION_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Worker concurrency ---
# How many jobs one worker runs at once (default 5). Each running job holds
# peer connections and a download pipeline; raise only with the RAM to match.
# With SQLite the worker runs one job at a time regardless (no advisory locks).
MAX_CONCURRENT_JOBS=5
